{
  "name": "@techandsoftware/teletext",
  "version": "0.13.3",
  "description": "API to render teletext pages using vector graphics in the browser DOM",
  "browser": "dist/teletext.umd.min.js",
  "module": "dist/teletext.min.js",
  "main": "dist/teletext.min.cjs",
  "type": "module",
  "exports": {
    "import": "./dist/teletext.min.js",
    "require": "./dist/teletext.min.cjs"
  },
  "engines": {
    "node": ">=12"
  },
  "private": false,
  "devDependencies": {
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-terser": "^0.4.0",
    "c8": "^7.7.1",
    "eslint": "^7.24.0",
    "jsdom": "^16.6.0",
    "rollup": "^3.12.0",
    "rollup-plugin-browsersync": "^1.3.1"
  },
  "scripts": {
    "dev": "rollup -c -w --watch.exclude 'dist/*' --no-watch.clearScreen",
    "build": "rollup -c rollup.prod.config.js",
    "coverage": "c8 --exclude node_modules --exclude tests node tests/tests.js",
    "reuselint": "reuse lint"
  },
  "keywords": [
    "teletext",
    "телетекст",
    "teletexto",
    "télétexte",
    "teletekst",
    "Videotext",
    "τελετέξτ",
    "World System Teletext",
    "WST"
  ],
  "author": "Tech & Software Ltd. <techandsoftwareltd@outlook.com>",
  "license": "(AGPL-3.0-only OR LicenseRef-uk.ltd.TechAndSoftware-1.0)",
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/rahardy/teletext.git"
  },
  "bugs": {
    "url": "https://bitbucket.org/rahardy/teletext/issues"
  },
  "files": [
    "LICENSES/AGPL-3.0-only.txt",
    "LICENSES/LicenseRef-uk.ltd.TechAndSoftware-1.0.txt",
    "dist",
    "package.json.license"
  ]
