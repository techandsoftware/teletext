{
  "name": "@techandsoftware/teletext",
  "version": "0.15.1",
  "description": "API to render teletext pages using vector graphics in the browser DOM",
  "browser": "dist/teletext.min.js",
  "module": "dist/teletext.min.js",
  "type": "module",
  "exports": {
    "import": "./dist/teletext.min.js"
  },
  "engines": {
    "node": ">=20"
  },
  "private": false,
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "terser": "^5.43.1",
    "vite": "^7.0.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run minify",
    "lint": "eslint",
    "minify": "terser dist/teletext.js --output dist/teletext.min.js --config-file terser.config.json",
    "reuselint": "reuse lint"
  },
  "keywords": [
    "teletext",
    "телетекст",
    "teletexto",
    "télétexte",
    "teletekst",
    "Videotext",
    "τελετέξτ",
    "World System Teletext",
    "WST"
  ],
  "author": "Rob Hardy <techandsoftwareltd@outlook.com>",
  "license": "(AGPL-3.0-only OR LicenseRef-uk.ltd.TechAndSoftware-1.0)",
  "repository": {
    "type": "git",
    "url": "git+https://bitbucket.org/rahardy/teletext.git"
  },
  "bugs": {
    "url": "https://bitbucket.org/rahardy/teletext/issues"
  },
  "files": [
    "LICENSES/AGPL-3.0-only.txt",
    "LICENSES/LicenseRef-uk.ltd.TechAndSoftware-1.0.txt",
    "dist",
    "package.json.license"
  ],
  "sideEffects": false
}
